// Portal de Fiscalização e Gestão de Fornecedores - Lifting
// Schema das fatias F0/F1 (fundação + acesso e autorização), F2
// (fornecedores), F3 (requisitos e documentos) e F4 (qualificação).
// Fonte de verdade das regras: docs/REGRAS_FUNCIONAIS.md
//
// Fiscalização e NC entram nas fatias F5+ (ver docs/DECISOES_PENDENTES.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// F1 — Acesso e autorização
// =============================================================================

enum UserRole {
  ADMIN_TI
  COMPRAS
  QSMS
  FORNECEDOR_ADMIN
  FORNECEDOR_COLABORADOR
}

enum UserStatus {
  INVITED // criado, aguardando definição de senha
  ACTIVE
  BLOCKED
  INACTIVE // desligado/inativado - histórico preservado
}

// Permissões sensíveis concedidas individualmente a usuários de COMPRAS/QSMS.
// Ver docs/REGRAS_FUNCIONAIS.md - "Perfis-base internos".
enum SensitivePermission {
  QUALIFICATION_DECIDE
  SUPPLIER_SUSPEND
  SUPPLIER_BLOCK
  SUPPLIER_UNBLOCK
  EXCEPTION_ACCEPT
  NC_REOPEN
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  passwordHash      String? // nulo enquanto o convite não foi ativado (status INVITED)
  role              UserRole
  status            UserStatus @default(INVITED)

  // Isolamento externo: obrigatório para perfis FORNECEDOR_*, sempre nulo
  // para perfis internos (ADMIN_TI/COMPRAS/QSMS). Validado em serviço, não
  // apenas no schema, porque Prisma não expressa constraint condicional.
  supplierId        String?
  supplier          Supplier?  @relation("SupplierUsers", fields: [supplierId], references: [id])

  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  grantedPermissions    UserPermission[]        @relation("PermissionHolder")
  permissionsGrantedBy  UserPermission[]        @relation("PermissionGrantor")
  auditLogsAsActor      AuditLog[]              @relation("AuditActor")
  supplierResponsibleOf SupplierResponsible[]   @relation("ResponsibleUser")
  uploadedFiles         FileObject[]
  documentVersionsSent      DocumentVersion[]   @relation("DocumentSubmitter")
  documentVersionsReviewed  DocumentVersion[]   @relation("DocumentReviewer")
  qualificationsStarted     Qualification[]     @relation("QualificationStartedBy")
  qualificationsDecided     Qualification[]     @relation("QualificationDecidedBy")
  inspectionsAsInspector    Inspection[]        @relation("InspectionInspector")
  inspectionsCreated        Inspection[]        @relation("InspectionCreatedBy")
  inspectionsConcluded      Inspection[]        @relation("InspectionConcludedBy")
  inspectionsCancelled      Inspection[]        @relation("InspectionCancelledBy")
  evidencesUploaded         Evidence[]          @relation("EvidenceUploadedBy")

  @@index([supplierId])
  @@index([role])
  @@map("users")
}

// Permissão sensível concedida a um usuário específico (não ao perfil).
model UserPermission {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation("PermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  permission  SensitivePermission

  grantedById String
  grantedBy   User                @relation("PermissionGrantor", fields: [grantedById], references: [id])
  grantedAt   DateTime            @default(now())

  revokedAt   DateTime?
  revokedById String?

  @@unique([userId, permission, revokedAt], name: "unique_active_grant")
  @@index([userId])
  @@map("user_permissions")
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Somente o hash do token opaco fica no banco; o valor em claro vai no cookie.
  tokenHash     String   @unique

  createdAt     DateTime @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  ipAddress     String?
  userAgent     String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?

  requestedIp String?

  @@index([userId])
  @@map("password_reset_tokens")
}

// Trilha de auditoria imutável (RNF-004, RF-118, RF-119, RF-120).
// Nunca é editada ou apagada pela interface.
model AuditLog {
  id             String   @id @default(cuid())

  actorId        String?
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorLabel     String? // preenchido quando o ator não é um usuário autenticado (ex.: "sistema", "anônimo")

  action         String // verbo padronizado, ex.: "auth.login.success", "supplier.registration.validate"
  entityType     String // ex.: "User", "Supplier"
  entityId       String?

  supplierId     String?
  supplier       Supplier? @relation("SupplierAuditLogs", fields: [supplierId], references: [id])

  reason         String? // motivo/justificativa quando aplicável a decisões sensíveis

  before         Json? // estado anterior minimizado (nunca segredo/senha/token)
  after          Json? // estado posterior minimizado

  context        Json? // { source: "web"|"api", ip, userAgent, correlationId }
  // interna: só equipe Lifting. externa: aparece na linha do tempo do portal do
  // fornecedor (RF-136, RN-021). restrita: nunca sai da auditoria interna completa.
  visibility     String   @default("interna")

  createdAt      DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([supplierId, visibility])
  @@map("audit_logs")
}

// =============================================================================
// F2 — Fornecedores
// =============================================================================

enum SupplyType {
  MATERIAL
  SERVICO
  AMBOS
}

// RF-015. Critérios objetivos de cada nível são decisão de negócio pendente
// (D-02, docs/DECISOES_PENDENTES.md) — o valor em si é livre até lá.
enum Criticality {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

// Estado cadastral (seção 5.1 da especificação). CONVITE_ENVIADO é criado
// junto com o Supplier por Compras — não existe um estado "pré-cadastro"
// separado: o próprio registro criado por Compras já É o pré-cadastro.
enum SupplierRegistrationStatus {
  CONVITE_ENVIADO
  EM_PREENCHIMENTO
  ENVIADO_PARA_ANALISE
  EM_ANALISE
  AJUSTES_SOLICITADOS
  CADASTRO_VALIDADO
  REJEITADO
  INATIVO
}

// Situação operacional (seção 5.3). Nesta fatia só é alterada manualmente
// (suspender/bloquear/desbloquear); o cômputo automático a partir de
// documentos/NC entra em fatias futuras (F3+), mantendo REGULAR/ATENCAO
// como estados de leitura por enquanto.
enum SupplierOperationalStatus {
  REGULAR
  ATENCAO
  IRREGULAR
  SUSPENSO
  BLOQUEADO
}

enum SupplierResponsibleType {
  COMPRADOR
  GESTOR_CONTRATO
  FISCAL
}

enum ContactType {
  COMERCIAL
  FINANCEIRO
  TECNICO
  QSMS
  OUTRO
}

model Supplier {
  id     String @id @default(cuid())
  cnpj   String @unique // somente dígitos, normalizado (RN-001)

  // Identificação (RF-010)
  legalName                String // razão social
  tradeName                String? // nome fantasia
  stateRegistration        String? // inscrição estadual
  municipalRegistration    String? // inscrição municipal
  website                  String?
  companySize              String? // porte (texto livre — sem taxonomia definitiva, ver D-02/D-03)
  registeredStatusInformed String? // situação cadastral informada manualmente (sem consulta automática, fora do escopo v0.1)

  // Endereço (RF-010)
  addressZip        String?
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressDistrict   String?
  addressCity       String?
  addressState      String? // UF
  addressCountry    String  @default("BR")

  // Fornecimento (RF-013)
  supplyType SupplyType?

  // Governança (RF-014, RF-015, RN-003)
  criticality Criticality?

  // Estados (seção 5)
  registrationStatus SupplierRegistrationStatus @default(CONVITE_ENVIADO)
  operationalStatus  SupplierOperationalStatus  @default(REGULAR)
  operationalReason  String? // motivo da última mudança de situação operacional (suspensão/bloqueio)

  // Convite (reaproveita PasswordResetToken do usuário FORNECEDOR_ADMIN criado
  // junto — não há token próprio do Supplier). Ver suppliers/services.
  inviteSentAt      DateTime?
  inviteCancelledAt DateTime?

  submittedAt DateTime? // primeiro envio para análise
  validatedAt DateTime? // quando o cadastro foi validado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]                @relation("SupplierUsers")
  auditLogs     AuditLog[]            @relation("SupplierAuditLogs")
  contacts      SupplierContact[]
  categories    SupplierCategory[]
  responsibles  SupplierResponsible[]
  requirements  SupplierRequirement[]
  qualifications Qualification[]
  inspections   Inspection[]

  @@index([registrationStatus])
  @@index([operationalStatus])
  @@index([criticality])
  @@map("suppliers")
}

model SupplierContact {
  id          String      @id @default(cuid())
  supplierId  String
  supplier    Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name        String
  role        String? // cargo
  email       String?
  phone       String?
  contactType ContactType @default(OUTRO)
  isPrimary   Boolean     @default(false)

  // Exclusão lógica — não apagar histórico de negócio (invariante geral).
  active      Boolean     @default(true)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([supplierId])
  @@map("supplier_contacts")
}

// Catálogo de categorias (RF-030). A matriz de requisitos por
// categoria/criticidade (RequirementRule) entra na fatia F3.
model Category {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  active      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierLinks SupplierCategory[]
  requirementRules RequirementRule[]
  checklistTemplates ChecklistTemplate[]

  @@map("categories")
}

model SupplierCategory {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  @@unique([supplierId, categoryId])
  @@index([categoryId])
  @@map("supplier_categories")
}

// Responsáveis internos (RF-014): comprador, gestor de contrato e fiscal.
// Mais de um usuário pode ocupar o mesmo papel para o mesmo fornecedor.
model SupplierResponsible {
  id         String                  @id @default(cuid())
  supplierId String
  supplier   Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  userId     String
  user       User                    @relation("ResponsibleUser", fields: [userId], references: [id])
  type       SupplierResponsibleType

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([supplierId, userId, type])
  @@index([supplierId])
  @@index([userId])
  @@map("supplier_responsibles")
}

// =============================================================================
// F3 — Requisitos e documentos
// =============================================================================

// RF-034: como a validade é calculada para uma versão aprovada.
enum ValidityType {
  FIXA // validUntil = data de emissão + validityDays
  INFORMADA // fornecedor informa a validade no envio
  SEM_VENCIMENTO
}

// RF-033.
enum RequirementObligation {
  OBRIGATORIO
  CONDICIONAL
  INFORMATIVO
}

// Ciclo do documento (seção 5.4). "Pendente" é o SupplierRequirement sem
// nenhuma versão ainda — não é um estado da versão em si. "Vencendo" e
// "Vencido" são calculados na leitura a partir de validUntil (não
// persistidos: não há job de vencimento nesta fatia, ver
// docs/DECISOES_PENDENTES.md), então não entram neste enum.
enum DocumentVersionStatus {
  ENVIADO
  EM_ANALISE
  APROVADO
  REJEITADO
}

// Tipo de documento/evidência (RF-031). O "Document" citado em
// docs/REGRAS_FUNCIONAIS.md como entidade própria foi fundido em
// SupplierRequirement nesta implementação — mesmo padrão de simplificação
// já registrado para Organization/Supplier na F2 (ver DECISOES_PENDENTES.md).
model RequirementType {
  id               String        @id @default(cuid())
  code             String        @unique
  name             String
  description      String?
  allowedFormats   String[] // subconjunto de {PDF, JPG, PNG} — vazio = usa o teto global (RF-040)
  validityType     ValidityType  @default(SEM_VENCIMENTO)
  validityDays     Int? // usado quando validityType = FIXA
  needsIssueDate   Boolean       @default(false)
  alertWindowDays  Int[]         @default([60, 30, 15, 7]) // RN-008 (padrão proposto, configurável por tipo)
  active           Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules        RequirementRule[]
  requirements SupplierRequirement[]

  @@map("requirement_types")
}

// Matriz de requisitos por categoria e criticidade (RF-032). Editar uma
// regra NUNCA reescreve SupplierRequirement já gerados (RF-038) — apenas
// reaplicar a matriz (ação explícita) recalcula o que é aplicável daqui
// para frente.
model RequirementRule {
  id                String                @id @default(cuid())
  requirementTypeId String
  requirementType   RequirementType       @relation(fields: [requirementTypeId], references: [id])
  categoryId        String
  category          Category              @relation(fields: [categoryId], references: [id])
  criticalities     Criticality[] // faixa de criticidade a que a regra se aplica (RF-032)
  obligation        RequirementObligation @default(OBRIGATORIO)
  active            Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requirementTypeId])
  @@index([categoryId])
  @@map("requirement_rules")
}

// Instância do requisito aplicável a um fornecedor específico — o "slot"
// onde as versões do documento são enviadas (RF-036, RF-051, RN-004).
model SupplierRequirement {
  id                String          @id @default(cuid())
  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  requirementTypeId String
  requirementType   RequirementType @relation(fields: [requirementTypeId], references: [id])

  // Snapshot da obrigatoriedade no momento da aplicação da matriz (RF-038) —
  // não muda retroativamente se a regra de origem for editada depois.
  obligation   RequirementObligation
  sourceRuleId String?

  // RN-005: requisito condicional precisa registrar a decisão de
  // aplicabilidade. Para OBRIGATORIO/INFORMATIVO, applicable é sempre true.
  applicable            Boolean   @default(true)
  applicabilityReason   String?
  applicabilityDecidedById String?
  applicabilityDecidedAt   DateTime?

  // Reaplicar a matriz pode tornar um requisito não mais pertinente
  // (categoria removida etc.); mantemos o histórico em vez de apagar.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions DocumentVersion[]

  @@unique([supplierId, requirementTypeId])
  @@index([supplierId])
  @@index([requirementTypeId])
  @@map("supplier_requirements")
}

// Metadados do arquivo em si (RNF-003): nunca em coluna binária do
// PostgreSQL, sempre no storage privado via StorageProvider (MinIO/S3).
model FileObject {
  id             String   @id @default(cuid())
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  storageKey     String   @unique // chave interna não previsível — nunca deriva do nome enviado

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  documentVersion DocumentVersion?
  evidence        Evidence?

  @@map("file_objects")
}

// Uma versão enviada de um documento (RF-042: reenvio nunca sobrescreve
// versão nem parecer anterior).
model DocumentVersion {
  id                    String                @id @default(cuid())
  supplierRequirementId String
  supplierRequirement   SupplierRequirement   @relation(fields: [supplierRequirementId], references: [id], onDelete: Cascade)
  versionNumber         Int

  fileObjectId String     @unique
  fileObject   FileObject @relation(fields: [fileObjectId], references: [id])

  // Metadados informados no envio (RF-041).
  documentNumber String?
  issuer         String?
  issuedAt       DateTime?
  validUntil     DateTime? // calculado (FIXA) ou informado (INFORMADA) no envio; confirmado/ajustado na aprovação (RF-046)
  submitterNote  String?

  status DocumentVersionStatus @default(ENVIADO)

  submittedById String
  submittedBy   User   @relation("DocumentSubmitter", fields: [submittedById], references: [id])

  reviewedById String?
  reviewedBy   User?     @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  // RN-009: toda rejeição exige motivo externo claro. Aprovação pode levar parecer opcional.
  reviewReason String?
  // RF-050: observação interna nunca é exposta ao portal do fornecedor.
  internalNote String?

  createdAt DateTime @default(now())

  @@index([supplierRequirementId])
  @@index([status])
  @@index([validUntil])
  @@map("document_versions")
}

// =============================================================================
// F4 — Qualificação
// =============================================================================

enum QualificationResult {
  APROVADO
  APROVADO_COM_RESSALVAS
  REPROVADO
}

// Rodada do processo de qualificação (RF-060, seção 5.2). RF-065: uma nova
// rodada (requalificação) nunca apaga a anterior — cada rodada é uma linha
// própria, e "round" cresce a cada requalificação. "Não iniciada" (seção
// 5.2) é a ausência de qualquer rodada para o fornecedor — não é persistida
// (mesmo padrão de "Pendente" em SupplierRequirement na F3). "Documentação
// pendente" e "Em validação" também não são persistidas: são calculadas na
// leitura a partir das pendências obrigatórias da rodada aberta (ver
// qualification-status.ts), o mesmo padrão de cálculo sob demanda já usado
// para Vencendo/Vencido em document-compliance.ts — só o resultado final
// (aprovado/aprovado com ressalvas/reprovado) é persistido e imutável.
//
// `QualificationDecision` (citada em docs/REGRAS_FUNCIONAIS.md como
// entidade própria) foi fundida aqui, mesmo padrão de simplificação já
// aplicado a Organization/Supplier (F2) e Document/SupplierRequirement
// (F3): nesta fatia cada rodada tem no máximo uma decisão final (pareceres
// múltiplos de Compras e QSMS — RF-062 — ficaram fora do MVP, ver
// docs/DECISOES_PENDENTES.md).
model Qualification {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  round      Int // 1 na primeira rodada; requalificação incrementa (RF-065)

  // Snapshot dos requisitos ativos (tipo + obrigatoriedade) no instante em
  // que a rodada abriu (RF-060: "vinculado ... à versão vigente da matriz").
  // Não é usado para calcular pendência (isso é sempre sobre o estado atual
  // dos SupplierRequirement) — é só o registro histórico do que existia
  // quando a rodada começou.
  matrixSnapshot Json

  startedAt   DateTime @default(now())
  startedById String
  startedBy   User     @relation("QualificationStartedBy", fields: [startedById], references: [id])

  // Decisão final (RF-063). Nula enquanto a rodada está aberta.
  result         QualificationResult?
  decidedAt      DateTime?
  decidedById    String?
  decidedBy      User?                @relation("QualificationDecidedBy", fields: [decidedById], references: [id])
  decisionReason String? // motivo obrigatório da decisão (RF-063)
  // Snapshot dos requisitos/documentos avaliados no momento da decisão
  // (regra do prompt mestre: "mantém resultado, justificativa, decisor(es),
  // data e snapshot dos requisitos/documentos avaliados") — histórico
  // imutável mesmo que o documento seja alterado ou vença depois.
  decisionSnapshot Json?

  // Ressalva (RF-064) — preenchida somente quando result = APROVADO_COM_RESSALVAS.
  conditionText        String?
  conditionResponsible String? // texto livre: quem responde pela condição (interno ou do fornecedor)
  conditionDeadline    DateTime?
  conditionEffect      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, round])
  @@index([supplierId])
  @@map("qualifications")
}

// =============================================================================
// F5 — Fiscalização
// =============================================================================

enum InspectionStatus {
  PROGRAMADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

// RF-071. NAO_APLICAVEL é sempre uma resposta possível no domínio; cada item
// pode restringir quais dessas quatro ele realmente aceita (allowedResponses).
enum InspectionResponse {
  CONFORME
  CONFORME_COM_RESSALVA
  NAO_CONFORME
  NAO_APLICAVEL
}

// Modelo de checklist (RF-070). Autoria é sempre no "vivo": editar
// seção/item aqui só afeta fiscalizações futuras ainda não criadas — RN-013
// é garantida por `Inspection.checklistSnapshot`, não por uma tabela de
// versões própria (ver decisão registrada em docs/DECISOES_PENDENTES.md:
// `ChecklistTemplateVersion`, citada em docs/REGRAS_FUNCIONAIS.md como
// entidade própria, foi fundida no snapshot da fiscalização).
model ChecklistTemplate {
  id          String    @id @default(cuid())
  title       String
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  active      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections    ChecklistSection[]
  inspections Inspection[]

  @@map("checklist_templates")
}

model ChecklistSection {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  order      Int

  items ChecklistItem[]

  @@index([templateId])
  @@map("checklist_sections")
}

// RF-071/RF-072/RF-073: por item, quais respostas são aceitas, quando
// evidência/observação é obrigatória, e se ele sugere a criação de uma NC
// (a NC em si — NonConformity — só existe a partir da F6; aqui fica só o
// metadado que a fatia futura vai consumir).
model ChecklistItem {
  id        String           @id @default(cuid())
  sectionId String
  section   ChecklistSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order     Int

  text     String
  guidance String? // orientação de preenchimento (RF-070)

  allowedResponses      InspectionResponse[] @default([CONFORME, CONFORME_COM_RESSALVA, NAO_CONFORME, NAO_APLICAVEL])
  evidenceRequiredOn     InspectionResponse[] @default([NAO_CONFORME]) // RF-072
  observationRequiredOn  InspectionResponse[] @default([NAO_CONFORME, NAO_APLICAVEL]) // RF-072, RN-014

  generatesNonConformity Boolean      @default(false) // RF-073
  defaultSeverity        Criticality? // RF-073 — usado só quando generatesNonConformity

  @@index([sectionId])
  @@map("checklist_items")
}

// Fiscalização (RF-075 a RF-082, seção 5.5). `checklistSnapshot` congela
// seções+itens do template no instante da criação (RF-074, RN-013): cada
// item recebe um `id` estável dentro do JSON, referenciado por
// `InspectionAnswer.itemId` — nunca a linha viva de `ChecklistItem`, para
// que editar/excluir o item no modelo não afete fiscalizações já criadas
// (RN-019, imutabilidade após conclusão).
model Inspection {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  templateId String?
  template   ChecklistTemplate? @relation(fields: [templateId], references: [id])
  checklistSnapshot Json

  // RF-075. Sem cadastro completo de projeto/contrato (D-08 continua
  // pendente) — referência livre por texto, mesma linha de D-02/D-03.
  projectOrLocation String?
  type              String? // taxonomia de tipos de fiscalização é decisão operacional (mesmo padrão de D-02/D-03)

  scheduledAt DateTime
  inspectorId String
  inspector   User     @relation("InspectionInspector", fields: [inspectorId], references: [id])

  status    InspectionStatus @default(PROGRAMADA)
  startedAt DateTime?

  concludedAt           DateTime?
  concludedById         String?
  concludedBy           User?     @relation("InspectionConcludedBy", fields: [concludedById], references: [id])
  // RN-015: conformidade = itens "conforme" / itens aplicáveis (exclui N/A) x 100.
  conformityPercentage  Float?

  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("InspectionCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  createdById String
  createdBy   User   @relation("InspectionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers InspectionAnswer[]

  @@index([supplierId])
  @@index([status])
  @@index([scheduledAt])
  @@map("inspections")
}

// Uma resposta por item do snapshot (RF-076: salva progressivamente).
// `itemId` refere-se ao id estável dentro de `Inspection.checklistSnapshot`
// — não é FK para `ChecklistItem` (o item pode já não existir mais lá).
model InspectionAnswer {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemId       String

  response    InspectionResponse?
  observation String?

  answeredAt   DateTime?
  answeredById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidences Evidence[]

  @@unique([inspectionId, itemId])
  @@index([inspectionId])
  @@map("inspection_answers")
}

// Foto/arquivo anexado a uma resposta (RF-077). Reaproveita FileObject/
// StorageProvider já usados para documentos — mesmo contrato de upload
// privado, hash e chave interna não previsível (RNF-003).
model Evidence {
  id                 String           @id @default(cuid())
  inspectionAnswerId String
  inspectionAnswer   InspectionAnswer @relation(fields: [inspectionAnswerId], references: [id], onDelete: Cascade)

  fileObjectId String     @unique
  fileObject   FileObject @relation(fields: [fileObjectId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([inspectionAnswerId])
  @@map("evidences")
}
