# Copie para .env e ajuste se necessário. Todos os valores abaixo são locais/fictícios,
# compatíveis com o docker-compose.yml deste repositório. Nunca coloque segredo real aqui.

NODE_ENV=development

# URL pública da aplicação (usada em links de convite/recuperação de senha)
APP_URL=http://localhost:3000

# Fuso horário oficial de exibição (datas são persistidas em UTC no banco)
APP_TIMEZONE=America/Sao_Paulo

# PostgreSQL (sobe via docker-compose.yml)
DATABASE_URL=postgresql://portal:portal_dev_password@localhost:5432/portal_fornecedores?schema=public

# Sessão
SESSION_COOKIE_NAME=portal_session
SESSION_TTL_HOURS=12

# Política de senha e bloqueio de acesso (RF-008)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60

# Armazenamento privado compatível com S3 (MinIO local via docker-compose.yml)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=portal_minio
STORAGE_SECRET_ACCESS_KEY=portal_minio_password
STORAGE_BUCKET=portal-fornecedores-documentos
STORAGE_FORCE_PATH_STYLE=true

# E-mail (Mailpit local via docker-compose.yml; troque por SMTP real em produção)
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Portal de Fornecedores Lifting <nao-responda@lifting.local>"
